// The version resource every gplvr binary carries -- what Explorer shows under Properties >
// Details. The numbers and the commit come from the generated build stamp header
// (tools/BuildStamp.cmake); which binary this is comes from one of GPLVR_RC_DLL, GPLVR_RC_LOADER
// or GPLVR_RC_PRESENTER, set per target in CMakeLists.txt.

#include <winver.h>

#include "GplvrBuildStamp.h"

#if defined(GPLVR_RC_DLL)
#define GPLVR_RC_DESCRIPTION "gplvr - Grand Prix Legends VR"
#define GPLVR_RC_FILENAME    "gplvr.dll"
#define GPLVR_RC_TYPE        VFT_DLL
#elif defined(GPLVR_RC_LOADER)
#define GPLVR_RC_DESCRIPTION "gplvr - Grand Prix Legends VR launcher"
#define GPLVR_RC_FILENAME    "gplvr.exe"
#define GPLVR_RC_TYPE        VFT_APP
#else
#define GPLVR_RC_DESCRIPTION "gplvr - Grand Prix Legends VR OpenXR presenter"
#define GPLVR_RC_FILENAME    "gplvr-xr.exe"
#define GPLVR_RC_TYPE        VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     GPLVR_VERSION_MAJOR, GPLVR_VERSION_MINOR, 0, 0
PRODUCTVERSION  GPLVR_VERSION_MAJOR, GPLVR_VERSION_MINOR, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        GPLVR_RC_TYPE
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  GPLVR_RC_DESCRIPTION
            VALUE "FileVersion",      GPLVR_VERSION_TEXT
            VALUE "InternalName",     GPLVR_RC_FILENAME
            VALUE "OriginalFilename", GPLVR_RC_FILENAME
            VALUE "ProductName",      "gplvr"
            VALUE "ProductVersion",   GPLVR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
